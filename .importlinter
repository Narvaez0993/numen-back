source_modules =
    src.modules.goals.adapters.outbound
forbidden_modules =
    src.modules.goals.adapters.inbound
allow_indirect_imports = True

# A pocket's money lives in movements' transfers; the hexagon says so through
# `FundsReader` and `TransferRecorder`, and only the outermost adapters know who
# answers. (Movements' pocket ledger reads INTO goals the same way, adapter-only.)
[importlinter:contract:goals-hexagon-independent-of-siblings]
name = goals — the hexagon cannot import sibling modules (only its adapters may)
type = forbidden
source_modules =
    src.modules.goals.domain
    src.modules.goals.application
forbidden_modules =
    src.modules.accounts
    src.modules.categories
    src.modules.movements
    src.modules.subscriptions
    src.modules.budgets
    src.modules.debts
    src.modules.auth
    src.modules.assistant

