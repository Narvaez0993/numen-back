# Copy to .env and fill in. Never commit .env.

# App
APP_ENV=development
LOG_LEVEL=INFO

# API
# Comma-separated origins. Includes Expo dev scheme + Metro dev server.
API_CORS_ORIGINS=["numen://","http://localhost:8081"]

# MongoDB — single-node replica set is REQUIRED for transactions
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB_NAME=numen

# Redis (ARQ)
REDIS_URL=redis://localhost:6379/0

# Auth / JWT
JWT_SECRET=change-me-in-production-must-be-at-least-32-characters-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# Email verification (delivery suspended; dev logs the code)
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# AI providers (leave empty in dev if not testing IA flows)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage (Cloudflare R2)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=numen-receipts

# Observability
SENTRY_DSN=
