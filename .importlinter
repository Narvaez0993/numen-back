name = overview — adapters/outbound cannot import adapters/inbound (direct)
type = forbidden
source_modules =
    src.modules.overview.adapters.outbound
forbidden_modules =
    src.modules.overview.adapters.inbound
allow_indirect_imports = True

# `overview` is the only module that reads across the others, and it may only do
# so from its OUTERMOST layer. Its hexagon declares what it needs (BalanceReader,
# MovementSummaryReader) and stays ignorant of who answers — which is what keeps
# Home growable (budgets, goals) without any module learning about another.
[importlinter:contract:overview-hexagon-independent-of-siblings]
name = overview — the hexagon cannot import sibling modules (only its adapters may)
type = forbidden
source_modules =
    src.modules.overview.domain
    src.modules.overview.application
forbidden_modules =
    src.modules.accounts
    src.modules.movements
    src.modules.categories
    src.modules.budgets
    src.modules.debts
    src.modules.goals
    src.modules.auth
    src.modules.assistant

# Nobody depends on `overview`: it is a leaf that composes read views. If this
# ever breaks, a module started reaching for a screen's shape instead of its own.
[importlinter:contract:assistant-hexagonal-layers]
name = assistant module — hexagonal layers (adapters → application → domain)
type = layers
layers =
    src.modules.assistant.adapters
    src.modules.assistant.application
    src.modules.assistant.domain

[importlinter:contract:assistant-inbound-forbids-outbound]
name = assistant — adapters/inbound cannot import adapters/outbound (direct)
type = forbidden
source_modules =
    src.modules.assistant.adapters.inbound
forbidden_modules =
    src.modules.assistant.adapters.outbound
allow_indirect_imports = True

[importlinter:contract:assistant-outbound-forbids-inbound]
name = assistant — adapters/outbound cannot import adapters/inbound (direct)
type = forbidden
source_modules =
    src.modules.assistant.adapters.outbound
forbidden_modules =
    src.modules.assistant.adapters.inbound
allow_indirect_imports = True

# The agent's tools read the other modules the way overview does: only from the
# OUTERMOST layer, one adapter per source, always through the other module's use
# cases. The hexagon knows ToolSpecs and Views — never who answers them. This is
# also what keeps `anthropic` quarantined: application-purity bans the SDK from
# the hexagon, so the model client can only ever live in adapters/outbound/ai.
[importlinter:contract:assistant-hexagon-independent-of-siblings]
name = assistant — the hexagon cannot import sibling modules (only its adapters may)
type = forbidden
source_modules =
    src.modules.assistant.domain
    src.modules.assistant.application
forbidden_modules =
    src.modules.accounts
    src.modules.categories
    src.modules.movements
    src.modules.subscriptions
    src.modules.budgets
    src.modules.debts
    src.modules.goals
    src.modules.auth

# Like overview, assistant is a composer: nobody builds on top of the agent.
[importlinter:contract:nobody-depends-on-assistant]
name = no module may import assistant
type = forbidden
source_modules =
    src.modules.auth
    src.modules.categories
    src.modules.accounts
    src.modules.movements
    src.modules.budgets
    src.modules.debts
    src.modules.goals
    src.modules.overview
forbidden_modules =
    src.modules.assistant
allow_indirect_imports = True

[importlinter:contract:nobody-depends-on-overview]
name = no module may import overview
type = forbidden
source_modules =
    src.modules.auth
    src.modules.categories
    src.modules.accounts
    src.modules.movements
    src.modules.budgets
    src.modules.debts
    src.modules.goals
    src.modules.assistant
forbidden_modules =
    src.modules.overview
# Indirect only: every router reaches the composition root through the shared
# `get_caller` dependency, and the root instantiates everything — including this
# module. Direct imports are what this contract is about.
allow_indirect_imports = True
