# movements needs accounts and categories to move money and validate references.
# The dependency is allowed only at its OUTERMOST layer (the anti-corruption
# adapters); `movements.application` and `.domain` stay ignorant of both, which is
# what keeps the coupling one-directional and testable with fakes.
[importlinter:contract:movements-hexagon-independent-of-siblings]
name = movements — the hexagon cannot import sibling modules (only its adapters may)
type = forbidden
source_modules =
    src.modules.movements.domain
    src.modules.movements.application
forbidden_modules =
    src.modules.accounts
    src.modules.categories
    src.modules.auth
    src.modules.assistant
    src.modules.subscriptions
    src.modules.goals

