# A cap is measured against spending it does not own. The hexagon says so through
# `SpendReader` and `CategoryReader`, and only the outermost adapters know that the
# answers come from `movements` and `categories`.
[importlinter:contract:budgets-hexagon-independent-of-siblings]
name = budgets — the hexagon cannot import sibling modules (only its adapters may)
type = forbidden
source_modules =
    src.modules.budgets.domain
    src.modules.budgets.application
forbidden_modules =
    src.modules.accounts
    src.modules.categories
    src.modules.movements
    src.modules.subscriptions
    src.modules.auth
    src.modules.assistant

[importlinter:contract:debts-hexagonal-layers]
name = debts module — hexagonal layers (adapters → application → domain)
type = layers
layers =
    src.modules.debts.adapters
    src.modules.debts.application
    src.modules.debts.domain

